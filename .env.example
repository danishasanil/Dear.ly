# GEMINI_API_KEY: Server-side secret required for Gemini AI API calls (Chat, Reflection, Live Voice).
# Injected securely into server runtime environment. Never exposed to browser.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# YOUTUBE_API_KEY: Optional server-side secret for YouTube Data API search fallback.
# Injected securely into server runtime environment. Never exposed to browser.
YOUTUBE_API_KEY=""

# VITE_FIREBASE_API_KEY: Optional client-side Firebase Web API key override.
VITE_FIREBASE_API_KEY=""

